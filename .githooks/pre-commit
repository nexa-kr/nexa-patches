#!/bin/sh
# 커밋 전 비밀값 검사(gitleaks). 설치: brew install gitleaks. 켜기: git config core.hooksPath .githooks
# 비공개 저장소는 GitHub 무료 플랜에서 비밀값 검사·push 차단이 없으므로 이 훅이 유일한 방어선이다.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks 가 없어 커밋을 막습니다 (brew install gitleaks)" >&2
  exit 1
fi
gitleaks git --staged --no-banner --redact . || exit 1
# 전역 훅(core.hooksPath 를 바꾸면 가려진다)이 있으면 이어서 돌린다.
g="$HOME/.codex/git-hooks/pre-commit"
[ -x "$g" ] && exec "$g" "$@"
exit 0
